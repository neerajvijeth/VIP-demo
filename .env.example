# Copy to .env for local development. In Databricks Apps most of these are injected by the platform / app.yaml.

# --- Connection (required) ---------------------------------------------------
DATABRICKS_HOST=<workspace-host>            # e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com or adb-123.4.azuredatabricks.net (no https://)
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>  # SQL warehouse the app queries
DATABRICKS_CATALOG=<catalog>                # catalog that holds the three gold tables
DATABRICKS_SCHEMA=<schema>

# --- Authentication (pick ONE) -------------------------------------------------
# A) Databricks CLI login, no secret stored (recommended locally):
#      databricks auth login --host https://<workspace-host> --profile <name>
DATABRICKS_CONFIG_PROFILE=<name>
# B) Personal access token:
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX
# C) Service principal OAuth (injected automatically on Databricks Apps):
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# --- Optional features ---------------------------------------------------------
# GENIE_SPACE_ID=<genie-space-id>           # enables the Chatbot
# USE_OBO=false                             # true = run queries as the signed-in user (Apps forwards their token)
# PORT=8000

# --- Limits & cost controls ----------------------------------------------------
# STATEMENT_TIMEOUT_SECONDS=120             # warehouse statement timeout
# EXPORT_MAX_ROWS=1000000                   # CSV export cap
# CACHE_TTL_SECONDS=300                     # short result cache for dashboard queries (0 = off)

# --- Adapting to different table / column names or values (all optional) -------
# TABLE_ASSETS=gold_assets
# TABLE_VULNERABILITIES=gold_vulnerabilities
# TABLE_KPI_METRICS=gold_kpi_metrics
# COLUMN_MAP={"kev_flag":"is_known_exploited","te_state":"status"}   # logical name -> your column
# CLOSED_STATES=FIXED                       # comma list: states that mean a finding is closed
# HIGH_SEVERITIES=Critical,High
# STALE_STATUS=Stale
# AGING_STATUS=Aging
# EOS_STATUS=EOS
# UPCOMING_EOS_STATUS=Upcoming EOS
